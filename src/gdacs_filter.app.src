{application, gdacs_filter, [
    {description, "em_filter example for Gdacs"},
    {vsn, "0.2.0"},
    {registered, [gdacs_filter_sup, gdacs_filter_server]},
    {mod, {gdacs_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        gdacs_filter_sup,
        gdacs_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/gdacs_filter"}]}
]}.
